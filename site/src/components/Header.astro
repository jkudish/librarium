---
const links = [
  { href: "/#providers", label: "Providers" },
  { href: "/#features", label: "Features" },
  { href: "/#library", label: "Library" },
  { href: "/docs", label: "Docs" },
];
---

<header class="border-b border-neutral-950/10">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6 lg:px-8">
    <a href="/" aria-label="Homepage" class="flex items-center gap-x-2">
      <span class="font-mono text-base font-semibold text-neutral-950">librarium</span>
    </a>
    <nav class="flex items-center gap-x-7">
      <div class="flex items-center gap-x-7 text-sm text-neutral-600 max-sm:hidden">
        {links.map((link) => (
          <a href={link.href} class="hover:text-neutral-950">{link.label}</a>
        ))}
      </div>
      <a
        href="https://github.com/jkudish/librarium"
        class="flex items-center gap-x-2 rounded-lg px-3 py-1.5 text-sm font-medium text-neutral-700 ring-1 ring-neutral-950/15 hover:bg-neutral-950/3"
      >
        <svg viewBox="0 0 16 16" class="size-4 shrink-0 fill-neutral-600" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
        GitHub
      </a>
      <button
        type="button"
        id="menu-toggle"
        class="relative -mr-2 rounded-lg p-2 text-neutral-600 hover:bg-neutral-950/3 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-600 sm:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke-width="1.5" class="size-6 stroke-neutral-600" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" /></svg>
        <span class="pointer-fine:hidden absolute top-1/2 left-1/2 size-[max(100%,3rem)] -translate-1/2" aria-hidden="true"></span>
      </button>
    </nav>
  </div>
  <div id="mobile-menu" hidden class="border-t border-neutral-950/10 sm:hidden!">
    <nav class="mx-auto flex max-w-6xl flex-col gap-y-1 px-4 py-3">
      {links.map((link) => (
        <a href={link.href} class="rounded-lg px-2 py-2 text-base text-neutral-700 hover:bg-neutral-950/3 hover:text-neutral-950">{link.label}</a>
      ))}
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  toggle?.addEventListener("click", () => {
    const isOpen = !menu?.hidden;
    if (menu) menu.hidden = isOpen;
    toggle.setAttribute("aria-expanded", String(!isOpen));
  });
</script>
